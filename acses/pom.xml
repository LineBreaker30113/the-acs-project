<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.halim</groupId>
        <artifactId>the-acs-project</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>acses</artifactId>
    <packaging>jar</packaging>

    <name>ACSES</name>
    <description>
        The database service, which uses ACSE; it acts as the requester when a service is already running.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.halim</groupId>
            <artifactId>acse</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>acsess</finalName>
        <plugins>
            <!-- The manifest names the main class and every runtime dependency under lib/, so java -jar
                 needs nothing else; the plain -SNAPSHOT names match the files the assembly puts there. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.halim.acses.acsess.ACSESS</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <useUniqueVersions>false</useUniqueVersions>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- target/acsess/: acsess.jar, bin/acsess, bin/acsess.cmd, and lib/ with acs, acse, fastutil and RoaringBitmap
                 as separate jars. Not one merged jar: a store copies what it reaches from the place the
                 contracts came from, so every database's classes.jar would carry fastutil and
                 RoaringBitmap, and a load would then meet two copies of the types the contracts name. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>acsess</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/acsess.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                            <attach>false</attach>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
