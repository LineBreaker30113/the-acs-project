<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.halim</groupId>
    <artifactId>the-acs-project</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>The ACS Project</name>
    <description>
        The Arity Component System: the parent project that compiles its modules together. ACS holds
        the contracts, ACSE implements them, ACSES uses ACSE for the database service, and
        OntoDirectory, ACS-alHikmet and the ACSAH viewer are built on them.
    </description>

    <modules>
        <module>acs</module>
        <module>acse</module>
        <module>acses</module>
        <!-- ontodirectory skipped for now: it still imports ACS_PersistenceManager from its former package -->
        <!-- <module>ontodirectory</module> -->
        <module>acs-alhikmet</module>
        <module>acsah-viewer</module>
        <module>acsess-gui</module>
    </modules>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0 only, with the Universal FOSS Exception v1.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
            <comments>The exception: https://oss.oracle.com/licenses/universal-foss-exception/ (see NOTICE). A commercial license is also offered.</comments>
        </license>
    </licenses>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.parameters>true</maven.compiler.parameters>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>it.unimi.dsi</groupId>
                <artifactId>fastutil</artifactId>
                <version>8.5.13</version>
            </dependency>
            <dependency>
                <groupId>org.roaringbitmap</groupId>
                <artifactId>RoaringBitmap</artifactId>
                <version>1.6.21</version>
            </dependency>
            <dependency>
                <groupId>org.halim</groupId>
                <artifactId>acs</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.halim</groupId>
                <artifactId>acse</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
