<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.halim</groupId>
        <artifactId>the-acs-project</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>acs-gui</artifactId>
    <packaging>jar</packaging>

    <name>ACS GUI</name>
    <description>
        The acsess GUI: OntoDirectory's GUI structure, with views of its own, showing and editing the
        databases acsed holds by running acsess, as a terminal does, and showing their stored classes from
        the database's files.
    </description>

    <!-- No dependency on acs, acse or acses: every request goes through the acsess program, and the stored
         classes are read from the database's own files, so this module builds on its own; one merged jar is
         safe, since nothing here stores a database. -->
    <dependencies>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.5.4</version>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf-extras</artifactId>
            <version>3.5.4</version>
        </dependency>
        <!-- The class content's syntax-colored editor, BSD-3-Clause: its copyright notice and disclaimer ship
             with the merged jar. The token colors are our own, set in CodeColors. -->
        <dependency>
            <groupId>com.fifesoft</groupId>
            <artifactId>rsyntaxtextarea</artifactId>
            <version>3.6.3</version>
        </dependency>
        <!-- The class content's decompiler, Apache-2.0. -->
        <dependency>
            <groupId>org.vineflower</groupId>
            <artifactId>vineflower</artifactId>
            <version>1.11.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.halim.acsgui.ACSGUI_Main</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
